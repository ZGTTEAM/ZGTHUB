{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zgt",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zgthub-account",
      "database_id": "48f39ece-827c-4945-be6e-7bb4a6dcf468"
    }
  ]
}