{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zgt",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {"directory":"./public","binding":"ASSETS","not_found_handling":"404-page"},
